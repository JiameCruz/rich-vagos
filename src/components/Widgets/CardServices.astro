---
const services = [
  { 
    title: "Lavado Interior y Exterior", 
    description: "Limpieza profunda de interiores y exteriores con acabado espejo.",
    icon: "truck" 
  },
  {
    title: "Lavado de Alta Presión",
    description: "Desengrasado seguro para componentes sensibles y mayor vida útil.",
    icon: "engine"
  },
  {
    title: "Lavado Interior Detallado",
    description: "Desinfección y restauración de plásticos para un ambiente premium.",
    icon: "cabin"
  },
  { 
    title: "Limpieza de Rines y Llantas", 
    description: "Eliminación de corrosión y suciedad acumulada en la base.",
    icon: "chassis"
  },
  {
    title: "Desengrasado de Motor",
    description: "Eliminación de rayas y restauración del brillo original.",
    icon: "polish"
  },
  {
    title: "Acabo Premium y Protección",
    description: "Eliminación de olores y bacterias con ozono de grado médico.",
    icon: "clean"
  },
];
---

{
  services.map((item, index) => (
    <div
      class="group relative overflow-hidden bg-zinc-50 border border-zinc-100 p-8 hover:bg-zinc-950 transition-all duration-500 aspect-square flex flex-col justify-between"
    >
      <!-- Background Text / Number -->
      <span class="absolute -right-4 -bottom-8 text-[12rem] font-black text-zinc-300 group-hover:text-zinc-900 transition-colors duration-500 leading-none">
        0{index + 1}
      </span>

      <div class="relative z-10 space-y-6">
        <div class="w-12 h-12 bg-red-600 flex items-center justify-center rounded-sm group-hover:scale-110 transition-transform duration-500">
           <!-- Generic Icon Placeholder -->
           <div class="w-6 h-6 border-2 border-white rounded-full"></div>
        </div>
        
        <h3 class="font-black text-black text-3xl uppercase tracking-tighter leading-none group-hover:text-white transition-colors duration-500">
          {item.title}
        </h3>
      </div>

      <div class="relative z-10">
        <div class="mt-6 w-0 group-hover:w-full h-1 bg-red-600 transition-all duration-700"></div>
      </div>
    </div>
  ))
}
