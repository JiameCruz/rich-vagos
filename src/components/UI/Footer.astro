---

---

<footer class="bg-zinc-950 text-zinc-400 py-16 px-6 border-t border-zinc-900">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
    <!-- Brand Section -->
    <div class="space-y-6">
      <div class="flex items-center gap-3">
        <img src="./public/logo.png" alt="Rich Vagos Logo" class="w-10 h-10" />
        <h2
          class="text-2xl font-black text-white tracking-tighter uppercase italic"
        >
          Rich Vagos
        </h2>
      </div>
      <p class="text-sm max-w-xs leading-relaxed font-medium">
        Lavado de Camión/Tráiler para personas exigentes. Expertos en limpieza
        de camiones y remolques.
      </p>
    </div>

    <!-- Social Section -->
    <div class="space-y-6">
      <h3 class="text-sm font-bold text-white uppercase tracking-[0.2em]">
        Conecta
      </h3>
      <div class="flex gap-4">
        <!-- Instagram -->
        <a
          href="https://www.instagram.com/ritch_vagos_power_wash?igsh=cTltYmNid29pZWlj&utm_source=qr"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center bg-zinc-900 rounded-xl hover:bg-red-600 hover:text-white transition-all duration-500 group border border-zinc-800"
          aria-label="Instagram"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:scale-110 transition-transform duration-500"
          >
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>
        <!-- WhatsApp -->
        <a
          href="https://wa.me/5218715084344"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center bg-zinc-900 rounded-xl hover:bg-green-600 hover:text-white transition-all duration-500 group border border-zinc-800"
          aria-label="WhatsApp"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="group-hover:scale-110 transition-transform duration-500"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.005 0C5.37 0 .002 5.368.002 12.006c0 2.096.548 4.14 1.593 5.945L.005 24l6.398-1.678a11.91 11.91 0 005.602 1.428h.001c6.635 0 12.003-5.368 12.003-12.006 0-3.208-1.248-6.229-3.518-8.498"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div
    class="max-w-7xl mx-auto mt-20 pt-8 border-t border-zinc-900 flex flex-col md:flex-row justify-between items-center gap-6 text-[10px] uppercase tracking-[0.3em] font-bold"
  >
    <p class="text-zinc-500">
      &copy; {new Date().getFullYear()}
      <span class="text-zinc-300">Rich Vagos </span>. All rights reserved.
    </p>
    <div class="flex items-center gap-4">
      <span class="text-zinc-600">México</span>
      <span class="w-1 h-1 bg-zinc-800 rounded-full"></span>
      <span class="text-zinc-600">Lavado de Camión/Tráiler</span>
    </div>
  </div>
</footer>
