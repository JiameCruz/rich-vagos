---
import Nav from "../Widgets/Nav.astro";
---

<header
  class="fixed top-0 left-0 w-full h-20 flex items-center justify-between px-8 z-50 transition-all duration-500 bg-zinc-950/90 backdrop-blur-md border-b border-zinc-900 shadow-2xl"
>
  <div class="flex items-center gap-4 group cursor-pointer">
    <div class="relative">
      <img
        src="./public/logo.png"
        alt="Rich Vagos Logo"
        class="w-12 h-12 group-hover:rotate-12 transition-transform duration-500"
      />
    </div>
    <div class="flex flex-col">
      <span
        class="text-xl font-black text-white tracking-tighter uppercase italic leading-none"
        >Rich Vagos</span
      >
      <span
        class="text-[8px] font-black text-red-600 uppercase tracking-[0.4em] leading-none mt-1"
        >Entertainment</span
      >
    </div>
  </div>

  <nav class="hidden md:flex gap-10 items-center">
    <Nav href="/">Home</Nav>
    <Nav href="#nosotros">Nosotros</Nav>
    <Nav href="#servicios">Servicios</Nav>
    <Nav href="#precios">Precios</Nav>
    <Nav
      href="#contacto"
      class="bg-red-600 px-6 py-2 rounded-sm text-white hover:bg-white hover:text-black transition-all duration-300 uppercase italic font-black text-xs tracking-widest"
    >
      Contacto
    </Nav>
  </nav>

  <!-- Mobile Toggle (Simplified) -->
  <button class="md:hidden text-white p-2">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><line x1="4" x2="20" y1="12" y2="12"></line><line
        x1="4"
        x2="20"
        y1="6"
        y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
    >
  </button>
</header>

<script>
  // Premium Smooth Scroll with Easing
  const navLinks = document.querySelectorAll('nav a[href^="#"]');

  navLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const targetId = link.getAttribute("href");
      if (!targetId || targetId === "#") return;

      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        const headerOffset = 80;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition =
          elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: "smooth",
        });

        // Bold Interaction: Highlight target section momentarily
        targetElement.classList.add(
          "ring-2",
          "ring-red-600/20",
          "transition-all",
          "duration-1000",
        );
        setTimeout(() => {
          targetElement.classList.remove("ring-2", "ring-red-600/20");
        }, 2000);
      }
    });
  });

  // Header Background Change on Scroll
  const header = document.querySelector("header");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header?.classList.add("h-16", "bg-zinc-950");
      header?.classList.remove("h-20", "bg-zinc-950/90");
    } else {
      header?.classList.add("h-20", "bg-zinc-950/90");
      header?.classList.remove("h-16", "bg-zinc-950");
    }
  });
</script>
