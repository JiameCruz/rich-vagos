<section
  id="contacto"
  class="grid grid-cols-1 md:grid-cols-2 w-full px-6 py-26 bg-white border-t border-zinc-100"
>
  <div class="m-auto w-full md:w-3/4 h-40">
    <h3
      class="mx-auto text-2xl text-black font-black uppercase italic text-center"
    >
      Contacanos
      <br />
      <span class="text-red-600">Ahora</span>
    </h3>
    <div class="h-0.5 w-full bg-gray-900 my-4"></div>
    <p class="prose lg:prose-xl text-black text-sm text-center">
      Habla por WhatsApp para poder agendar una cita en lavado de camiones
    </p>
  </div>

  <a
    href="https://wa.me/5218715084344"
    target="_blank"
    rel="noopener noreferrer"
    class="m-auto bg-red-600 rounded-full w-full md:w-3/4 h-30
    shadow-md hover:shadow-2xl hover:shadow-green-500/50 transition-all duration-500
    hover:-translate-y-2 hover:bg-green-600 hover:text-white
    flex items-center justify-center group"
    aria-label="WhatsApp"
  >
    <div class="w-full h-full flex justify-center items-center">
      <svg
        xmlns="http://www.w3.org/2000/svg"
