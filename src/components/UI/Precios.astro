---
import CardPrice from "../Widgets/CardPrice.astro";
import CTA from "../Widgets/CTA.astro";
---

<section
  id="precios"
  class="w-full px-6 py-32 bg-zinc-50 border-t border-zinc-100 overflow-hidden"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div
      class="flex flex-col md:flex-row justify-between items-end gap-10 mb-24 relative"
    >
      <span
        class="absolute -left-20 -top-20 text-[15rem] font-black text-zinc-100/50 -z-10 select-none"
        >PRICES</span
      >
      <div class="space-y-4">
        <span
          class="text-red-600 font-black uppercase tracking-[0.3em] text-xs block"
          >Tarifas Transparentes</span
        >
        <h2
          class="text-6xl md:text-9xl font-black text-black tracking-tighter uppercase italic leading-[0.8]"
        >
          Precios <br />
          <span class="text-red-600">Directos</span>
        </h2>
      </div>
      <div class="space-y-6 max-w-sm">
        <p class="text-zinc-500 font-medium text-xl leading-tight">
          Sin sorpresas. Solo el mejor servicio de lavado para tu trailer con
          precios competitivos.
        </p>
        <div class="h-1 w-24 bg-red-600"></div>
      </div>
    </div>

    <!-- Individual Prices Grid -->
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 mb-32">
      <CardPrice />
    </div>

    <!-- Featured Combos -->
    <div class="space-y-12">
      <h3
        class="text-3xl font-black text-black uppercase italic tracking-tighter"
      >
        Promociones <span class="text-red-600">Rich</span>
      </h3>

      <div class="grid grid-cols-1 gap-8">
        <!-- Combo Básico -->
        <div
          class="group relative bg-white border border-zinc-200 p-10 flex flex-col justify-between min-h-[400px] hover:bg-zinc-950 transition-all duration-700 overflow-hidden"
        >
          <span
            class="absolute -right-10 -top-10 text-[10rem] font-black text-zinc-50 group-hover:text-zinc-900 transition-colors duration-500 italic"
            >01</span
          >

          <div class="relative z-10">
            <h4
              class="text-4xl font-black text-black uppercase tracking-tighter group-hover:text-white transition-colors duration-500"
            >
              Combo Básico
            </h4>
            <p class="text-xl text-zinc-500 group-hover:text-zinc-400 mt-2">
              Lavado Exterior + Caja
            </p>
          </div>

          <div class="relative z-10 flex items-baseline gap-4 mt-auto">
            <span class="text-6xl font-black text-red-600">$900</span>
            <span
              class="text-zinc-400 font-bold uppercase tracking-widest text-sm"
              >MXN</span
            >
            <div class="ml-auto">
              <CTA>Reservar Ahora</CTA>
            </div>
          </div>
        </div>

        <!-- Combo Completo -->
        <div
          class="group relative bg-red-600 p-10 flex flex-col justify-between min-h-[400px] hover:bg-zinc-950 transition-all duration-700 overflow-hidden border border-red-500"
        >
          <span
            class="absolute -right-10 -top-10 text-[10rem] font-black text-red-700 group-hover:text-zinc-900 transition-colors duration-500 italic"
            >02</span
          >

          <div class="relative z-10">
            <h4
              class="text-4xl font-black uppercase tracking-tighter text-white"
            >
              Combo Completo
            </h4>
            <p class="text-xl text-red-100 group-hover:text-zinc-400 mt-2">
              Lavado Exterior + Lavado Interior + Caja
            </p>
          </div>

          <div class="relative z-10 flex items-baseline gap-4 mt-auto">
            <span
              class="text-6xl font-black text-white group-hover:text-red-600 transition-colors duration-500"
              >$1,500</span
            >
            <span
              class="text-red-200 group-hover:text-zinc-500 font-bold uppercase tracking-widest text-sm transition-colors duration-500"
              >MXN</span
            >
            <div class="ml-auto">
              <CTA>Reservar Ahora</CTA>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
